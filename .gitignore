.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json
service-account*.json

# --- AI assistant / editor state (never commit) ------------------------------
.cursor/
.cursorrules
.cursorignore
.cursor-*
.claude/
.claude-*
CLAUDE.md
# Written by `next dev` for AI coding agents; regenerated locally, not project source.
AGENTS.md
.codex/
.aider*
.continue/
.windsurf/
.copilot/
*.agent-state*
*.memory.json
memory/
agent-transcripts/
transcripts/
.specstory/
.history/
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# --- OS junk -----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Node / frontend ---------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
dist/
build/
.turbo/
.vercel/
next-env.d.ts
*.tsbuildinfo
coverage/
playwright-report/
test-results/
blob-report/
.eslintcache

# --- Python / backend --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage
