coverage.xml
*.log

# --- Runtime data (temporary media, uploads, results) ------------------------
data/
# Anchored: an unanchored `storage/` also ignored the API's source package
# apps/api/src/anything_download/storage/.
/storage/
tmp/
temp/
*.tmp
apps/api/data/
apps/api/storage/

# --- Docker ------------------------------------------------------------------
docker-compose.override.yml

# --- Local tooling -----------------------------------------------------------
.tooling/
# Anchored: an unanchored `tools/` also ignored apps/api/src/anything_download/tools/
# and apps/web/src/app/tools/ (most of the application).
/tools/
