# =============================================================================
# Anything Download: environment variables
# Copy this file to `.env` (never commit `.env`) and adjust values.
# Backend variables use the AD_ prefix. Frontend variables use NEXT_PUBLIC_.
# =============================================================================

# --- Site / CORS -------------------------------------------------------------
# Public origin of the web app. Comma-separated list is accepted for CORS.
AD_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_NAME=Anything Download

# --- Runtime -----------------------------------------------------------------
# development | test | production
AD_ENV=development
AD_LOG_LEVEL=INFO
# console | json
AD_LOG_FORMAT=console
AD_API_ROOT_PATH=

# --- Redis -------------------------------------------------------------------
AD_REDIS_URL=redis://localhost:6379/0

# --- Storage -----------------------------------------------------------------
# Ephemeral local directory. Results and uploads are deleted by the cleanup worker.
AD_STORAGE_DIR=./data

# --- Media binaries ----------------------------------------------------------
AD_FFMPEG_BIN=ffmpeg
AD_FFPROBE_BIN=ffprobe

# --- Limits ------------------------------------------------------------------
AD_MAX_FILE_SIZE_MB=500
AD_MAX_UPLOAD_SIZE_MB=200
AD_MAX_JOB_DURATION_SECONDS=600
AD_MAX_VIDEO_DURATION_SECONDS=7200
AD_MAX_CONCURRENT_JOBS=2
AD_MAX_QUEUE_DEPTH=200
# Largest JSON/form body outside the streaming upload endpoint.
AD_MAX_REQUEST_BODY_KB=256
# Threads per ffmpeg process (decoders, encoder, filters). 0 = every core.
AD_FFMPEG_THREADS=2
# Refuse new uploads/jobs below this much free space on the storage filesystem.
# Keep above AD_MAX_FILE_SIZE_MB x AD_MAX_CONCURRENT_JOBS x workers.
AD_MIN_FREE_DISK_MB=2048
# Optional quota on the storage directory (0 = none).
AD_MAX_STORAGE_MB=0
AD_MAX_URL_LENGTH=2048
AD_MAX_WEBPAGE_BYTES=3145728
AD_MAX_WEBPAGE_RESOURCES=300
AD_MAX_PDF_PAGES=500
AD_MAX_IMAGE_PIXELS=50000000
AD_MAX_REDIRECTS=5
AD_HTTP_CONNECT_TIMEOUT_SECONDS=8
AD_HTTP_READ_TIMEOUT_SECONDS=20
AD_SUBPROCESS_GRACE_SECONDS=5

# --- Retention (minutes unless noted) ----------------------------------------
AD_RESULT_TTL_MINUTES=30
AD_UPLOAD_TTL_MINUTES=30
AD_JOB_RECORD_TTL_MINUTES=120
AD_CLEANUP_INTERVAL_SECONDS=60

# --- Rate limiting -----------------------------------------------------------
AD_RATE_LIMIT_ENABLED=true
AD_RATE_LIMIT_ANALYZE_PER_MINUTE=30
AD_RATE_LIMIT_JOBS_PER_MINUTE=20
AD_RATE_LIMIT_UPLOADS_PER_MINUTE=10
AD_RATE_LIMIT_GENERAL_PER_MINUTE=240
# Enable only when the API sits behind a trusted reverse proxy.
AD_TRUST_PROXY_HEADERS=false

# --- Feature flags -----------------------------------------------------------
AD_ENABLE_PLATFORM_EXTRACTORS=true
# URL→PDF and screenshot require Playwright + Chromium in the worker image.
AD_ENABLE_BROWSER_TOOLS=false
# Development convenience. Production disables docs unless this is set true
# in the process environment (not only a copied .env file).
AD_ENABLE_DOCS=true

# --- Networking / safety -----------------------------------------------------
AD_USER_AGENT=AnythingDownload/0.1 (+https://github.com/sandeepbollavaram/anything-download)
# Testing only. Never enable in production.
AD_ALLOW_PRIVATE_TARGETS=false
